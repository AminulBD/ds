---
import Base from '../layouts/Base.astro';
import data from '../data/tlds.json';

const { rows, counts, priceRange, generated } = data;
const fmt = (n: number) => n.toLocaleString('en-US');
const money = (n: number | null) => (n === null ? '—' : `$${n.toFixed(2)}`);
const host = (url: string | null) => {
  if (!url) return null;
  try { return new URL(url).host; } catch { return url; }
};

// The column is a mean, but only over the registrars that actually sell the
// TLD — so it says who those are, and how many TLDs more than one of them
// quotes. If the table ever narrows back to a single registrar, saying
// "average" would be false and the note says whose list price it is instead.
const registrars = Object.keys(data.sellers).sort();
const singleSource = registrars.length === 1 ? registrars[0] : null;
const registrarList = new Intl.ListFormat('en', { type: 'conjunction' }).format(registrars);
const multiPriced = rows.filter((r) => r.sellers.length > 1).length;

// The "sold by" filter, busiest registrar first — it is a shortcut to "what
// can I actually buy here", so the one selling the most TLDs comes first.
const sellerOptions = Object.entries(data.sellers).sort((a, b) => b[1] - a[1]);

// Every registrar's search page, once, rather than the same template repeated
// on each of the ~2,000 chips — the page ships one row per TLD already, so
// what is spent per chip is spent 2,000 times.
const searchPages: Record<string, string> = {};
for (const r of rows) {
  for (const sl of r.sellers) if (sl.search) searchPages[sl.registrar] = sl.search;
}

// `.com` without the `.com`: the price beside it is what the chip is for, and
// four full hostnames per row costs more width than the suffix is worth.
const shortName = (registrar: string) => registrar.replace(/\.com$/, '');

// One entry per eligibility rule rather than per TLD, because sub-zones
// inherit: .au's rule is also .com.au's, and printing it seven times would
// suggest seven rules. `from` is the TLD the rule is written against.
type Rule = { note: string; source: string; from: string };
const groups = new Map<string, { from: string; rule: Rule; tlds: string[] }>();
for (const r of rows) {
  const rule = r.eligibility as Rule | null;
  if (!rule) continue;
  const g = groups.get(rule.from) ?? { from: rule.from, rule, tlds: [] };
  g.tlds.push(r.tld);
  groups.set(rule.from, g);
}
const ruleGroups = [...groups.values()].sort((a, b) => a.from.localeCompare(b.from));
// .বাংলা reads better than .xn--54b7fta0cc in a list of rules.
const readable = new Map(rows.map((r) => [r.tld, r.unicode]));
const label = (tld: string) => `.${readable.get(tld) ?? tld}`;

const SOURCE_LABEL: Record<string, string> = {
  both: 'RDAP + WHOIS',
  rdap: 'RDAP',
  whois: 'WHOIS',
  none: 'neither',
};
---

<Base
  title="TLD prices and registries — every TLD ds knows"
  description={`Registration and renewal prices for ${fmt(counts.priced)} top-level domains, which registrars sell each one, who is eligible to register, and the RDAP endpoint or WHOIS server that answers for each of ${fmt(counts.total)} TLDs.`}
>
  <div class="wrap page">
    <h1>TLDs &amp; prices</h1>
    <p class="lede muted">
      Every TLD <code>ds</code> carries data for — {fmt(counts.total)} of them — with what
      each costs to register, <a href="#registering">where you can buy one</a>, whether the
      registry <a href="#who-can-register">lets everyone register</a>, and which registry
      answers for it. Every TLD's name links to <a href="/tlds/com/">its own page</a>, with each
      registrar's three prices, the registry's lookup server and the rest of what <code>ds</code>
      knows about it. All of it is read straight out of the binary's own tables, so a figure
      here is the figure the CLI will use.
    </p>

    <div class="stats">
      <div><strong>{fmt(counts.total)}</strong><span>TLDs</span></div>
      <div><strong>{fmt(counts.priced)}</strong><span>priced</span></div>
      <div><strong>{fmt(counts.rdap)}</strong><span>RDAP</span></div>
      <div><strong>{fmt(counts.whois)}</strong><span>WHOIS</span></div>
      <div><strong>{fmt(counts.cctld)}</strong><span>country-code</span></div>
      <div><strong>{fmt(counts.restricted)}</strong><span>restricted</span></div>
    </div>

    <div class="controls">
      <label class="search">
        <span class="visually-hidden">Filter TLDs</span>
        <input
          type="search" id="q" placeholder="Filter — try io, co.uk, porkbun, or Canadian"
          autocomplete="off" spellcheck="false"
        />
      </label>
      <label>
        <span class="visually-hidden">Lookup source</span>
        <select id="source">
          <option value="">Any source</option>
          <option value="rdap">Has RDAP</option>
          <option value="whois">Has WHOIS</option>
          <option value="none">Neither</option>
        </select>
      </label>
      <label>
        <span class="visually-hidden">TLD type</span>
        <select id="kind">
          <option value="">Any type</option>
          <option value="gtld">Generic — .com, .xyz ({fmt(counts.gtld)})</option>
          <option value="cctld">Country-code — .de, .io ({fmt(counts.cctld)})</option>
          <option value="idn">Internationalised — .рф ({fmt(counts.idn)})</option>
        </select>
      </label>
      <label>
        <span class="visually-hidden">Registration level</span>
        <select id="level">
          <option value="">Any level</option>
          <option value="2">Second level — .com ({fmt(counts.second)})</option>
          <option value="3">Third level — .co.uk ({fmt(counts.third)})</option>
        </select>
      </label>
      <label>
        <span class="visually-hidden">Who can register</span>
        <select id="private">
          <option value="">Any zone</option>
          <option value="no">Excluding private ({fmt(counts.total - counts.private)})</option>
          <option value="restricted">Restricted — eligibility rule ({fmt(counts.restricted)})</option>
          <option value="yes">Private only — .aws, .google ({fmt(counts.private)})</option>
        </select>
      </label>
      <label>
        <span class="visually-hidden">DNSSEC</span>
        <select id="dnssec">
          <option value="">Any DNSSEC</option>
          <option value="signed">Signed — DS in the root ({fmt(counts.signed)})</option>
          <option value="unsigned">Unsigned ({fmt(counts.inRoot - counts.signed)})</option>
          {counts.notDelegated > 0 && (
            <option value="none">Not in the root zone ({fmt(counts.notDelegated)})</option>
          )}
        </select>
      </label>
      <label>
        <span class="visually-hidden">Sold by</span>
        <select id="seller">
          <option value="">Any registrar</option>
          {sellerOptions.map(([name, n]) => (
            <option value={name}>{name} ({fmt(n)})</option>
          ))}
          <option value="none">Nobody in the table ({fmt(counts.unsold)})</option>
        </select>
      </label>
      <label class="check">
        <input type="checkbox" id="priced" /> Priced only
      </label>
      <p class="count faint" id="count" aria-live="polite">
        {fmt(counts.total)} TLDs
      </p>
    </div>

    <div class="namebar" id="registering">
      <label for="name">Register at</label>
      <input
        type="text" id="name" placeholder="mybrand" autocomplete="off" spellcheck="false"
        aria-describedby="name-hint"
      />
      <p class="faint" id="name-hint">
        A name here points every registrar link at its search for{' '}
        <code id="name-example">that name</code> — the same page{' '}
        <code id="name-command">ds mybrand --tld de --where</code> would hand you.
      </p>
    </div>

    <div class="table-scroll">
      <table id="tbl">
        <thead>
          <tr>
            <th aria-sort="ascending" data-active="1"><button type="button" data-sort="tld">TLD</button></th>
            <th class="num"><button type="button" data-sort="price">Register</button></th>
            <th class="num"><button type="button" data-sort="renew">Renew</button></th>
            <th><button type="button" data-sort="sellers">Register at</button></th>
            <th><button type="button" data-sort="source">Source</button></th>
            <th>Registry</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr
              data-tld={r.tld}
              data-price={r.price ?? ''}
              data-renew={r.renew ?? ''}
              data-source={r.source}
              data-rdap={r.rdapServer ? '1' : ''}
              data-whois={r.whoisHost ? '1' : ''}
              data-kind={r.kind}
              data-level={r.level}
              data-private={r.private ? 'yes' : 'no'}
              data-restricted={r.eligibility ? 'yes' : 'no'}
              data-dnssec={r.rootZone ? (r.rootZone.signed ? 'signed' : 'unsigned') : 'none'}
              data-sellers={r.sellers.map((sl) => sl.registrar).join(' ')}
              data-sellcount={r.sellers.length}
              data-search={`${r.tld} ${r.unicode ?? ''} ${host(r.rdapServer) ?? ''} ${r.whoisHost ?? ''} ${r.privateOperator ?? ''} ${r.sellers.map((sl) => sl.registrar).join(' ')} ${r.eligibility?.note ?? ''}`.toLowerCase()}
            >
              <th scope="row" class="tld">
                <a class="tld-link" href={`/tlds/${r.tld}/`}>
                  {r.unicode ? (
                    <><span class="tld-uni">.{r.unicode}</span><span class="tld-puny">.{r.tld}</span></>
                  ) : (
                    <>.{r.tld}</>
                  )}
                </a>
                {r.private && (
                  <span
                    class="tag tag-private"
                    title={r.privateOperator
                      ? `Brand TLD — only ${r.privateOperator} registers names here (ICANN Specification 13)`
                      : 'Reserved — no public registrations'}
                  >private</span>
                )}
                {r.eligibility && (
                  <a
                    class="tag tag-restricted"
                    href={`#rule-${r.eligibility.from}`}
                    title={`${r.eligibility.note}${
                      r.eligibility.from === r.tld ? '' : ` (the rule .${r.eligibility.from} sets)`
                    }`}
                  >restricted</a>
                )}
              </th>
              <td class="num">{money(r.price)}</td>
              <td class="num faint">{money(r.renew)}</td>
              <td class="sellers">
                {r.sellers.length === 0 ? (
                  <span class="faint" title="No registrar in the bundled price table quotes this TLD">—</span>
                ) : (
                  r.sellers.map((sl) =>
                    sl.home ? (
                      <a
                        class="seller" href={sl.home} data-r={sl.registrar}
                        target="_blank" rel="noopener nofollow" title={sl.registrar}
                      >{shortName(sl.registrar)} <span class="seller-price">{money(sl.price)}</span></a>
                    ) : (
                      <span class="seller" title={sl.registrar}
                      >{shortName(sl.registrar)} <span class="seller-price">{money(sl.price)}</span></span>
                    ),
                  )
                )}
              </td>
              <td>
                <span class={`tag tag-${r.source}`}>{SOURCE_LABEL[r.source]}</span>
              </td>
              <td class="reg faint">{host(r.rdapServer) ?? r.whoisHost ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty" id="empty" hidden>Nothing matches that filter.</p>
    </div>

    <nav class="pager" id="pager" aria-label="TLD table pages" hidden>
      <label class="perpage">
        <span class="visually-hidden">Rows per page</span>
        <select id="perpage">
          <option value="10">10 per page</option>
          <option value="20">20 per page</option>
          <option value="50">50 per page</option>
          <option value="100">100 per page</option>
          <option value="0">Show all {fmt(counts.total)}</option>
        </select>
      </label>
      <div class="pagenav" id="pagenav">
        <button type="button" id="prev">Previous</button>
        <span class="pagelist" id="pagelist"></span>
        <button type="button" id="next">Next</button>
      </div>
    </nav>

    <section class="who" id="who-can-register">
      <h2>Who can register</h2>
      <p class="muted intro">
        {fmt(counts.restricted)} of these TLDs are not open to everyone: the registry asks
        for residency, a local company, a trade licence or an accreditation before it will
        sell you a name. A domain reported <code>AVAILABLE</code> under one of them means the
        label is free, not that you may have it. {ruleGroups.length} rules cover the{' '}
        {fmt(counts.restricted)}, because sub-zones inherit — <code>.com.au</code> is{' '}
        <code>.au</code>'s rule.
      </p>
      <dl class="rules">
        {ruleGroups.map((g) => (
          <div class="rule" id={`rule-${g.from}`}>
            <dt>
              <span class="rule-tld">{label(g.from)}</span>
              {g.tlds.length > 1 && (
                <span class="rule-also faint">
                  and {g.tlds.filter((t) => t !== g.from).slice(0, 6).map((t) => label(t)).join(', ')}
                  {g.tlds.length > 7 && <> +{g.tlds.length - 7} more</>}
                </span>
              )}
            </dt>
            <dd>
              {g.rule.note}
              <a class="rule-src" href={g.rule.source} target="_blank" rel="noopener">
                {host(g.rule.source)}
              </a>
            </dd>
          </div>
        ))}
      </dl>
      <p class="faint after">
        These notes are hand-maintained — no registry publishes its rules in a form a program
        can read — so each one carries the page it was taken from, and that page, not this
        table, is the authority. They were last checked on {data.eligibilityChecked}, they say
        what kind of gate exists rather than the exact legal test, and they cover the
        restricted TLDs a registrar is likely to offer you. <strong>A TLD missing from this
        list is not thereby open.</strong>
      </p>
    </section>

    <section class="notes prose">
      <h2>About this data</h2>
      <ul>
        <li>
          <strong>Prices are {singleSource ? <>{singleSource} list prices</> : <>list prices from {registrarList}</>}</strong>,
          bundled with the CLI and last regenerated {generated}. They cover {fmt(counts.priced)} of
          the {fmt(counts.total)} TLDs here, from {money(priceRange.min)} to {money(priceRange.max)} a
          year; the rest show <code>—</code> because nothing in the table prices them.{' '}
          {singleSource ? (
            <> The file has room for several registrars per TLD and <code>ds</code> averages
            across them, but every entry currently quotes {singleSource}, so treat these as one
            registrar's list prices rather than a market average.</>
          ) : (
            <> Where more than one of them sells a TLD — {fmt(multiPriced)} of these rows —
            the figure is the mean of their list prices. Where only one does, it is that
            registrar's price alone, which is a quote rather than a market rate.</>
          )}
        </li>
        <li>
          <strong>Register is the first year, Renew is every year after.</strong> The two often
          differ by a lot — a name can be a couple of dollars to register and forty to keep.
          Treat both as list prices, not quotes: promotions, ICANN fees, taxes and premium
          names all move the real number, and a registry may not sell you the TLD at
          all. Supply your own table with <code>--pricing-file</code>; see{' '}
          <a href="/docs/choosing-the-source#your-own-prices">Your own prices</a>.
        </li>
        <li>
          <strong>Register at is evidence, not a guess.</strong> Each name there is a
          registrar whose own price list carries the TLD, cheapest first — nobody quotes a
          price for something they cannot sell you, which is why <code>.de</code> lists three
          and <code>.fr</code> two. It is the same list <code>ds --where</code> prints; put a
          name in the box above the table and each one becomes that registrar's search for
          it. A <code>—</code> means no registrar in the bundled table quotes
          the TLD — {fmt(counts.unsold)} of these rows — which is a gap in the table as
          often as it is a TLD nobody sells. See{' '}
          <a href="/docs/showing-more#where-to-register">Where to register</a>.
        </li>
        <li>
          <strong>Restricted</strong> marks the {fmt(counts.restricted)} TLDs whose registry
          will not sell to just anyone — <code>.eu</code> wants an EU registrant,{' '}
          <code>.ca</code> a Canadian one, <code>.bank</code> a bank. The tag links to the
          rule and the registry page it came from, all of which are listed under{' '}
          <a href="#who-can-register">Who can register</a>. Availability and eligibility are
          different questions, and <code>ds</code> answers the first: it prints the rule
          beside the name rather than filtering the TLD out.
        </li>
        <li>
          <strong>Source</strong> is which protocol answers: RDAP endpoints come from{' '}
          <a href="https://data.iana.org/rdap/dns.json">IANA's bootstrap</a>, refreshed when this
          page is built; WHOIS servers come from the bundled <code>whois.json</code>. RDAP is
          authoritative, WHOIS is text matching — see <a href="/docs/accuracy-notes">Accuracy notes</a>.
        </li>
        <li>
          <strong>Type and level are separate filters</strong>, as they are in the CLI:
          type is measured on the last label (the TLD of <code>co.uk</code> is <code>uk</code>),
          level is where the name actually sits. So country-code plus second level gives the{' '}
          {fmt(counts.rows2ndCctld)} bare ccTLDs — <code>.de</code>, <code>.io</code>,{' '}
          <code>.jp</code> — while country-code alone also sweeps in <code>.co.uk</code> and{' '}
          <code>.com.au</code>. The CLI spells the same pair{' '}
          <code>--cctld --level second</code>.
        </li>
        <li>
          <strong>Country-code</strong> means a two-letter TLD, which is exactly what ICANN
          reserves for ISO 3166-1 codes and exactly what <code>--cctld</code> selects.
          Internationalised TLDs are listed separately because they are punycode rather than
          two ASCII letters — which means a few country TLDs whose readable form is a country
          code, <code>.рф</code> and <code>.срб</code> among them, count as internationalised
          here and are likewise missed by <code>--cctld</code>.
        </li>
        <li>
          <strong>This table is slightly wider than <code>--tld all</code></strong>. That sweep
          covers the {fmt(counts.total - counts.none)} TLDs with a registry to ask;{' '}
          {counts.none} more are priced in the bundled table but have neither an RDAP endpoint
          nor a WHOIS server on file — resold third-level suffixes like <code>.co.com</code>,
          and country codes a registrar will sell you whose registry publishes no public
          lookup at all, like <code>.al</code> and <code>.ao</code>. They are listed here, tagged{' '}
          <span class="tag tag-none">neither</span>, and asking for one by name still works if
          IANA can name a server for it.
        </li>
        <li>
          <strong>Private</strong> marks the {fmt(counts.private)} zones nobody outside the
          registry can register in — brand TLDs like <code>.aws</code> and <code>.google</code>,
          whose operator is the only permitted registrant, plus <code>.arpa</code> and the names
          reserved by RFC. The flag is ICANN's{' '}
          <a href="https://www.icann.org/resources/registries/gtlds/v2/gtlds.json">
            published registry-agreement list
          </a>, where a Specification 13 exemption means exactly that. <code>ds</code> reports
          those <code>PRIVATE</code> instead of <code>AVAILABLE</code> and leaves them out of{' '}
          <code>--tld all</code>; see{' '}
          <a href="/docs/choosing-tlds#brand-and-reserved-tlds">Brand and reserved TLDs</a>. An
          untagged row is not a promise that the TLD is on sale — only that nothing says it is
          closed.
        </li>
        <li>
          <strong>Whether a TLD is signed comes from the root zone</strong>, not from us:{' '}
          {fmt(counts.signed)} of these rows have a DS record in the root, which is what lets a resolver prove an
          answer under them is genuine. A sub-zone is counted on its apex's record — <code>.co.uk</code> is secured
          by <code>.uk</code>'s. The zone is also the one hard test of whether a TLD exists at all, and{' '}
          {counts.notDelegated > 0 ? (
            <>{fmt(counts.notDelegated)} of these rows fail it</>
          ) : (
            <>every row here passes it</>
          )} — see <a href="/root-zone/">the root zone</a>.
        </li>
        <li>
          A few registries answer nobody: <code>.li</code> and <code>.qa</code> refuse public
          WHOIS and have no RDAP, so <code>ds</code> reports them <code>UNKNOWN</code> rather
          than guessing.
        </li>
      </ul>
      <p>
        Check any of these for real:{' '}
        <code>ds mybrand --tld io,de,co.uk</code>
      </p>
    </section>
  </div>

  <script type="application/json" id="search-pages" set:html={JSON.stringify(searchPages)} />

  <script>
    const tbody = document.querySelector<HTMLTableSectionElement>('#tbl tbody')!;
    const allRows = Array.from(tbody.rows);
    const q = document.querySelector<HTMLInputElement>('#q')!;
    const source = document.querySelector<HTMLSelectElement>('#source')!;
    const kind = document.querySelector<HTMLSelectElement>('#kind')!;
    const level = document.querySelector<HTMLSelectElement>('#level')!;
    const priv = document.querySelector<HTMLSelectElement>('#private')!;
    const dnssec = document.querySelector<HTMLSelectElement>('#dnssec')!;
    const seller = document.querySelector<HTMLSelectElement>('#seller')!;
    const priced = document.querySelector<HTMLInputElement>('#priced')!;
    const name = document.querySelector<HTMLInputElement>('#name')!;
    const example = document.querySelector<HTMLElement>('#name-example')!;
    const command = document.querySelector<HTMLElement>('#name-command')!;
    const count = document.querySelector<HTMLParagraphElement>('#count')!;
    const empty = document.querySelector<HTMLParagraphElement>('#empty')!;
    const scroller = document.querySelector<HTMLElement>('.table-scroll')!;
    const pager = document.querySelector<HTMLElement>('#pager')!;
    const pagenav = document.querySelector<HTMLElement>('#pagenav')!;
    const pagelist = document.querySelector<HTMLElement>('#pagelist')!;
    const prevBtn = document.querySelector<HTMLButtonElement>('#prev')!;
    const nextBtn = document.querySelector<HTMLButtonElement>('#next')!;
    const perPageSel = document.querySelector<HTMLSelectElement>('#perpage')!;

    let sortKey = 'tld';
    let sortDir = 1;

    // Every row ships in the HTML, so the table is whole with JS off and the
    // whole thing is still in the page source; paging is a view over those
    // rows rather than a fetch. `order` is the current sort, `matched` the
    // rows passing the filters in that order, and `shown` the slice actually
    // on screen — kept so that turning a page touches twice the page size
    // rather than all 1,808 rows.
    let order = allRows.slice();
    let matched = order;
    let shown = order.slice();
    let page = 1;
    let perPage = Number(perPageSel.value);

    // The smallest size on offer: under it there is nothing to page through at
    // any setting, so the pager — the size select with it — goes away.
    const smallest = Math.min(
      ...Array.from(perPageSel.options).map((o) => Number(o.value)).filter(Boolean),
    );

    const num = (v: string | undefined) => (v ? parseFloat(v) : NaN);
    const fmtN = (n: number) => n.toLocaleString('en-US');

    function apply(reset = true) {
      const term = q.value.trim().toLowerCase();
      const src = source.value;
      const k = kind.value;
      const lvl = level.value;
      const pv = priv.value;
      const ds = dnssec.value;
      const sv = seller.value;
      const onlyPriced = priced.checked;

      matched = order.filter((row) => {
        const d = row.dataset;
        let ok = !term || (d.search ?? '').includes(term);
        if (ok && src === 'rdap') ok = d.rdap === '1';
        if (ok && src === 'whois') ok = d.whois === '1';
        if (ok && src === 'none') ok = d.source === 'none';
        if (ok && k) ok = d.kind === k;
        if (ok && lvl) ok = d.level === lvl;
        // The zone select mixes two questions — closed to everyone, or open to
        // some — because both answer "could I register here at all".
        if (ok && pv) ok = pv === 'restricted' ? d.restricted === 'yes' : d.private === pv;
        if (ok && ds) ok = d.dnssec === ds;
        if (ok && sv) ok = sv === 'none' ? d.sellcount === '0' : (d.sellers ?? '').split(' ').includes(sv);
        if (ok && onlyPriced) ok = d.price !== '';
        return ok;
      });

      // A narrower filter should show you its first results, not page 7 of
      // whatever the last filter matched — and not halfway down that page.
      if (reset) { page = 1; scroller.scrollTop = 0; }
      render();
    }

    /** Page numbers worth a button: both ends, and a window around the current
     *  page. `null` is a gap, drawn as an ellipsis. */
    function pageNumbers(current: number, pages: number) {
      const want = new Set([1, pages, current - 1, current, current + 1]);
      // Pad whichever end we are at, so the strip keeps a steady width and the
      // buttons do not shuffle under the cursor as you page through.
      if (current <= 3) for (const n of [2, 3, 4]) want.add(n);
      if (current >= pages - 2) for (const n of [pages - 3, pages - 2, pages - 1]) want.add(n);

      const nums = [...want].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
      const out: (number | null)[] = [];
      for (const [i, n] of nums.entries()) {
        if (i && n - nums[i - 1] > 1) out.push(null);
        out.push(n);
      }
      return out;
    }

    function render() {
      const size = perPage || Math.max(matched.length, 1);
      const pages = Math.max(1, Math.ceil(matched.length / size));
      // A filter narrower than the page you were on lands you on the last one.
      page = Math.min(Math.max(1, page), pages);

      const start = (page - 1) * size;
      const slice = matched.slice(start, start + size);
      // Put away only what is currently up, rather than all 1,808 rows a turn.
      for (const row of shown) row.hidden = true;
      for (const row of slice) row.hidden = false;
      shown = slice;

      const n = matched.length;
      const filtered = n !== allRows.length;
      count.textContent =
        slice.length === n
          ? filtered
            ? `${fmtN(n)} of ${fmtN(allRows.length)} TLDs`
            : `${fmtN(n)} TLDs`
          : `${fmtN(start + 1)}–${fmtN(start + slice.length)} of ${fmtN(n)}${filtered ? ' matches' : ' TLDs'}`;
      empty.hidden = n > 0;

      pager.hidden = n <= smallest;
      pagenav.hidden = pages <= 1;
      prevBtn.disabled = page === 1;
      nextBtn.disabled = page === pages;
      pagelist.replaceChildren(
        ...pageNumbers(page, pages).map((p) => {
          if (p === null) {
            const gap = document.createElement('span');
            gap.className = 'gap';
            gap.textContent = '…';
            return gap;
          }
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'pagenum';
          b.textContent = fmtN(p);
          b.setAttribute('aria-label', `Page ${p} of ${pages}`);
          if (p === page) b.setAttribute('aria-current', 'page');
          b.addEventListener('click', () => goTo(p));
          return b;
        }),
      );
    }

    function goTo(p: number) {
      page = p;
      render();
      // Land on the first row of the new page: the top of the rows inside the
      // pane, and the top of the pane itself in the window.
      scroller.scrollTop = 0;
      scroller.scrollIntoView({ block: 'start' });
    }

    function sortBy(key: string) {
      sortDir = key === sortKey ? -sortDir : 1;
      sortKey = key;

      order = [...order].sort((a, b) => {
        const A = a.dataset, B = b.dataset;
        if (key === 'sellers') {
          const x = Number(A.sellcount), y = Number(B.sellcount);
          // Ascending here means *most* registrars first: sorting the TLDs
          // nobody sells to the top would be a column of dashes.
          return (y - x) * sortDir || A.tld!.localeCompare(B.tld!);
        }
        if (key === 'price' || key === 'renew') {
          const x = num(A[key]), y = num(B[key]);
          // Unpriced TLDs always sort last, whichever way the column is going.
          if (isNaN(x) && isNaN(y)) return A.tld!.localeCompare(B.tld!);
          if (isNaN(x)) return 1;
          if (isNaN(y)) return -1;
          return (x - y) * sortDir;
        }
        return (A[key] ?? '').localeCompare(B[key] ?? '') * sortDir;
      });

      const frag = document.createDocumentFragment();
      for (const r of order) frag.appendChild(r);
      tbody.appendChild(frag);

      // The filter has not changed, only the order — so re-order what already
      // matched rather than re-reading every control.
      const keep = new Set(matched);
      matched = order.filter((r) => keep.has(r));
      // Cheapest-first means the cheapest: page one, top of the rows.
      page = 1;
      scroller.scrollTop = 0;
      render();

      document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) => {
        const active = b.dataset.sort === key;
        const th = b.closest('th')!;
        th.setAttribute('aria-sort', active ? (sortDir === 1 ? 'ascending' : 'descending') : 'none');
        th.dataset.active = active ? String(sortDir) : '';
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-sort]')
      .forEach((b) => b.addEventListener('click', () => sortBy(b.dataset.sort!)));

    prevBtn.addEventListener('click', () => goTo(page - 1));
    nextBtn.addEventListener('click', () => goTo(page + 1));
    perPageSel.addEventListener('change', () => {
      // Keep the row you were looking at on screen rather than throwing you
      // back to the first page every time the size changes.
      const first = (page - 1) * (perPage || Math.max(matched.length, 1));
      perPage = Number(perPageSel.value);
      page = perPage ? Math.floor(first / perPage) + 1 : 1;
      render();
    });

    let t: number;
    q.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => apply(), 90);
    });
    [source, kind, level, priv, dnssec, seller, priced]
      .forEach((el) => el.addEventListener('change', () => apply()));

    // --- registrar links -------------------------------------------------
    // Each link points at the registrar's own site until a name is given, and
    // at that registrar's search for name.tld once one is — the same page
    // `ds <name> --tld <tld> --where` hands you.
    const searchPages: Record<string, string> = JSON.parse(
      document.querySelector<HTMLScriptElement>('#search-pages')!.textContent!,
    );
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a.seller')).map((a) => ({
      a,
      tld: (a.closest('tr') as HTMLTableRowElement).dataset.tld!,
      registrar: a.dataset.r!,
    }));

    /** What a registrar's search will accept: a label, not a sentence. */
    const clean = (s: string) => s.trim().toLowerCase().replace(/[^a-z0-9-]/g, '');

    function fillLinks() {
      const n = clean(name.value);
      example.textContent = n ? `${n}.de` : 'that name';
      command.textContent = `ds ${n || 'mybrand'} --tld de --where`;
      for (const { a, tld, registrar } of links) {
        const tpl = searchPages[registrar];
        a.href = n && tpl ? tpl.replace('{domain}', `${n}.${tld}`) : `https://${registrar}/`;
      }
    }

    let nt: number;
    name.addEventListener('input', () => {
      clearTimeout(nt);
      nt = window.setTimeout(fillLinks, 150);
    });

    // Deep-link support: /tlds?q=io&name=mybrand&page=3
    const params = new URLSearchParams(location.search);
    const initial = params.get('q');
    if (initial) { q.value = initial; }
    const initialName = params.get('name');
    if (initialName) { name.value = clean(initialName); }
    const initialPage = Number(params.get('page'));
    if (Number.isInteger(initialPage) && initialPage > 1) { page = initialPage; }
    fillLinks();
    // Keep the page the URL asked for; render() clamps it if the filter turns
    // out to be narrower than that.
    apply(false);
  </script>
</Base>

<style>
  .page { padding: 3rem 1.5rem; }
  .lede { font-size: 1.05rem; max-width: 70ch; margin-top: -.5rem; }

  .stats {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1rem;
    padding: 1.25rem 0; border-block: 1px solid var(--border); margin: 1.75rem 0;
  }
  @media (max-width: 640px) { .stats { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }
  .stats div { display: flex; flex-direction: column; }
  .stats strong { font-family: var(--mono); font-size: 1.35rem; letter-spacing: -.02em; }
  .stats span { color: var(--fg-muted); font-size: .8rem; }

  .controls {
    display: flex; flex-wrap: wrap; gap: .4rem; align-items: center;
    margin-bottom: .75rem; position: sticky; top: 3.75rem; z-index: 20;
    background: var(--bg); padding: .6rem 0;
  }
  .controls .search { flex: 1 1 14rem; }
  /* Four controls will not sit on one line on a phone. Pack them two to a row
     and stop pinning them, or the filter bar alone eats half the screen. */
  @media (max-width: 720px) {
    .controls { position: static; padding: .5rem 0 .75rem; gap: .5rem; }
    .controls .search { flex: 1 1 100%; }
    .controls > label:not(.search):not(.check) { flex: 1 1 calc(50% - .25rem); min-width: 0; }
    .controls > label:not(.search):not(.check) select { width: 100%; }
    .check { flex: 0 0 auto; }
    .count { margin-left: auto; }
  }
  .controls input[type="search"], .controls select {
    width: 100%; font: inherit; font-size: .82rem;
    /* A select and a search box do not agree on their own line box, so state
       it — without this the filter sits a few pixels taller than the selects
       beside it. */
    line-height: 1.35; padding: .3rem .5rem; border-radius: 5px;
    border: 1px solid var(--border-strong); background: var(--surface); color: var(--fg);
  }
  /* Leave room for the native chevron, or long option labels run under it. */
  .controls select { padding-right: 1.6rem; text-overflow: ellipsis; }
  .controls select { width: auto; }
  .controls input[type="search"]:focus-visible, .controls select:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 1px;
  }
  .check { display: flex; align-items: center; gap: .35rem; font-size: .82rem; color: var(--fg-muted); white-space: nowrap; }
  .count { margin: 0 0 0 auto; font-size: .8rem; white-space: nowrap; }

  /* Bounding the height is what makes the header below actually stick.
     `overflow-x: auto` already made this a scroll container on both axes, so
     the header pins to this box rather than to the viewport — but while the
     box was as tall as its contents it never scrolled, and the header simply
     left with the page. Capped, the rows scroll inside it and the header
     stays. The cap clears the site header, the pinned filter bar and the
     pager. */
  .table-scroll {
    overflow: auto; max-height: calc(100vh - 11rem); min-height: 18rem;
    border: 1px solid var(--border); border-radius: var(--radius);
  }
  #tbl { font-size: .9rem; }
  /* Measured from .table-scroll, not the viewport — 0 is the only offset that
     lines up. The pinned TLD column below is what keeps a long row readable
     sideways, as this does downwards. */
  #tbl thead th { position: sticky; top: 0; background: var(--bg-soft); z-index: 10; padding: 0; }
  #tbl thead th button {
    all: unset; box-sizing: border-box; display: block; width: 100%; cursor: pointer;
    padding: .6rem .7rem; font-size: .75rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .05em; color: var(--fg-muted);
  }
  #tbl thead th button:hover { color: var(--fg); }
  #tbl thead th button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  #tbl thead th[data-active="1"] button::after { content: " ↑"; color: var(--accent); }
  #tbl thead th[data-active="-1"] button::after { content: " ↓"; color: var(--accent); }
  #tbl thead th.num button { text-align: right; }
  #tbl tbody tr:hover { background: var(--bg-soft); }
  /* Row headers are <th>, so they inherit the global uppercase column-header
     styling — reset it, or every TLD reads as .AAA. */
  #tbl tbody th.tld {
    font-family: var(--mono); font-weight: 550; text-align: left;
    text-transform: none; letter-spacing: normal;
    font-size: .9rem; color: var(--fg);
  }
  /* The TLD is a link to its own page, but it is also the row's header — it
     reads as the name of the row, not as 1,808 lines of link-coloured text. */
  .tld-link { color: inherit; text-decoration: none; display: block; }
  .tld-link:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .tld-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
  /* Punycode TLDs show the readable form first, the A-label under it — the
     registry answers for the A-label, so both are worth having. */
  .tld-uni { display: block; }
  .tld-puny { display: block; font-size: .74rem; color: var(--fg-faint); }

  /* Keep the TLD in view while the rest of the row scrolls sideways — without
     it you lose track of which TLD a price belongs to on a narrow screen. */
  #tbl tbody th.tld, #tbl thead th:first-child {
    position: sticky; left: 0; z-index: 5;
    background: var(--bg);
    box-shadow: 1px 0 0 var(--border);
  }
  #tbl thead th:first-child { background: var(--bg-soft); z-index: 15; }
  #tbl tbody tr:hover th.tld { background: var(--bg-soft); }
  #tbl .num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
  #tbl .reg { font-family: var(--mono); font-size: .8rem; max-width: 22rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .tag {
    display: inline-block; font-size: .72rem; padding: .1rem .45rem;
    border-radius: 4px; border: 1px solid var(--border-strong); color: var(--fg-muted);
    white-space: nowrap;
  }
  .tag-both  { color: var(--available); border-color: color-mix(in srgb, var(--available) 45%, transparent); }
  .tag-rdap  { color: var(--available); border-color: color-mix(in srgb, var(--available) 30%, transparent); }
  .tag-whois { color: var(--unknown);   border-color: color-mix(in srgb, var(--unknown) 40%, transparent); }
  .tag-none  { color: var(--fg-faint); }
  .tag-private { color: var(--taken); border-color: color-mix(in srgb, var(--taken) 40%, transparent); margin-left: .4rem; }
  .tag-restricted {
    color: var(--unknown); border-color: color-mix(in srgb, var(--unknown) 40%, transparent);
    margin-left: .4rem; text-decoration: none;
  }
  a.tag-restricted:hover { background: color-mix(in srgb, var(--unknown) 12%, transparent); }
  a.tag-restricted:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  /* The name box sits with the column it drives rather than in the filter bar:
     it changes where the links go, not which rows are shown. */
  .namebar {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem .6rem;
    margin: 0 0 .6rem;
  }
  .namebar label { font-size: .8rem; font-weight: 600; color: var(--fg-muted); }
  .namebar input {
    font: inherit; font-family: var(--mono); font-size: .82rem;
    line-height: 1.35; padding: .3rem .5rem; border-radius: 5px; width: 9.5rem;
    border: 1px solid var(--border-strong); background: var(--surface); color: var(--fg);
  }
  .namebar input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .namebar p { margin: 0; font-size: .78rem; flex: 1 1 20rem; }

  /* Chips, not a list: four registrars on one line beats four lines per row
     across 1,800 rows. */
  #tbl .sellers { max-width: 24rem; }
  .seller {
    display: inline-block; margin: .1rem .3rem .1rem 0;
    font-family: var(--mono); font-size: .78rem; white-space: nowrap;
    padding: .1rem .4rem; border-radius: 4px;
    border: 1px solid var(--border); color: var(--fg-muted); text-decoration: none;
  }
  a.seller:hover { border-color: var(--border-strong); color: var(--fg); background: var(--bg-soft); }
  a.seller:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .seller-price { color: var(--fg-faint); font-variant-numeric: tabular-nums; }

  .who { margin-top: 3rem; }
  .who .intro, .who .after { max-width: var(--measure); }
  .who .after { font-size: .88rem; margin-top: 1.25rem; }
  .rules {
    margin: 1.5rem 0 0; border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden;
  }
  /* The restricted tags in the table link down here, and the filter bar is
     still pinned over the page — clear both it and the site header. */
  .rule { display: grid; grid-template-columns: 14rem 1fr; gap: 0 1.25rem; padding: .8rem 1rem; scroll-margin-top: 9rem; }
  .rule + .rule { border-top: 1px solid var(--border); }
  .rule:target { background: var(--bg-soft); box-shadow: inset 3px 0 0 var(--accent); }
  .rule dt { display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
  .rule dd { margin: 0; font-size: .92rem; }
  .rule-tld { font-family: var(--mono); font-weight: 550; font-size: .92rem; }
  .rule-also { font-size: .76rem; font-family: var(--mono); line-height: 1.4; }
  .rule-src { display: block; margin-top: .3rem; font-size: .78rem; font-family: var(--mono); }
  @media (max-width: 720px) {
    /* The filter bar stops being sticky here, so only the header is in the way. */
    .rule { scroll-margin-top: 5rem; }
  }
  @media (max-width: 640px) {
    .rule { grid-template-columns: 1fr; gap: .35rem; }
  }

  .empty { padding: 2rem; text-align: center; color: var(--fg-muted); }

  /* The table is paged rather than dropping 1,808 rows on the page at once.
     The pager is hidden in the markup and shown by the script, so with JS off
     you still get every row — and `display: flex` in an author sheet beats the
     UA's `[hidden] { display: none }`, hence the reset below. */
  .pager {
    display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem;
    margin-top: 1rem;
  }
  .pagenav { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem; margin-left: auto; }
  .pager[hidden], .pagenav[hidden] { display: none; }
  .pagelist { display: flex; align-items: center; gap: .2rem; }
  .pager select {
    font: inherit; font-size: .85rem; padding: .4rem 1.9rem .4rem .6rem;
    border-radius: 6px; border: 1px solid var(--border-strong);
    background: var(--surface); color: var(--fg);
  }
  /* The numbered buttons are built by the script, so they never carry Astro's
     scoping attribute and a plain `.pagenav button` would miss them — hence
     `:global`, kept under the scoped `.pagenav` so it still reaches no
     further than this pager. */
  .pagenav :global(button) {
    font: inherit; font-family: var(--mono); font-size: .85rem;
    padding: .4rem .6rem; min-width: 2.3rem; cursor: pointer;
    border-radius: 6px; border: 1px solid var(--border-strong);
    background: var(--surface); color: var(--fg-muted);
  }
  .pagenav :global(button:hover:not(:disabled)) { color: var(--fg); border-color: var(--fg-faint); }
  .pager select:focus-visible, .pagenav :global(button:focus-visible) {
    outline: 2px solid var(--accent); outline-offset: 1px;
  }
  .pagenav :global(button:disabled) { opacity: .45; cursor: default; }
  /* The page you are on, marked the way the sorted column is. */
  .pagenav :global(button[aria-current="page"]) {
    color: var(--fg); border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .pagelist :global(.gap) { color: var(--fg-faint); padding: 0 .15rem; }
  /* A page turn scrolls back here, so clear the site header and the pinned
     filter bar — without this the first rows land underneath them. */
  .table-scroll { scroll-margin-top: 9rem; }
  @media (max-width: 720px) {
    /* The filter bar stops being pinned at this width, so only the header is
       in the way — which also gives the rows more room — and the pager has no
